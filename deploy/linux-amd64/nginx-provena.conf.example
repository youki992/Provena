# Replace provena.example.com and certificate paths before enabling.
# Create the Basic Auth password file shown below before reloading Nginx.
limit_req_zone $binary_remote_addr zone=provena_rate:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name provena.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name provena.example.com;

    ssl_certificate /etc/letsencrypt/live/provena.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/provena.example.com/privkey.pem;
    client_max_body_size 20m;

    # This console can invoke security tools. Keep it access-controlled even
    # when it is reachable from the public Internet.
    auth_basic "Provena";
    auth_basic_user_file /etc/nginx/.htpasswd-provena;

    location / {
        limit_req zone=provena_rate burst=20 nodelay;
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }
}
