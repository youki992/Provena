[Unit]
Description=Provena service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create this unprivileged account before enabling the service.
User=provena
Group=provena
WorkingDirectory=/opt/provena
Environment="PATH=/opt/provena/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/bin/bash /opt/provena/start.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
